{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "keep_vars": true,
  "compatibility_date": "2026-10-13",
  "vars": {
    "FIRSTREP_ACCESS_AUD": "41a0d8837e446665e4ac204fdd580d55c7d4bd2e7b18d8257b439cbbc7f3144c",
    "FIRSTREP_ACCESS_TEAM_DOMAIN": "sparkling-dawn-0b88.cloudflareaccess.com"
  },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "josephjasin.com",
      "custom_domain": true
    },
    {
      "pattern": "www.josephjasin.com",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "main": "firstrep/server/worker.ts",
  "d1_databases": [
    {
      "binding": "FIRSTREP_DB",
      "database_name": "firstrep",
      "migrations_dir": "firstrep/migrations"
    }
  ]
}
