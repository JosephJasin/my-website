{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./_site"
  },
  "routes": [
    { "pattern": "josephjasin.com", "custom_domain": true },
    { "pattern": "www.josephjasin.com", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  }
}
